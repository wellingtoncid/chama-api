# =============================================
# CHAMA FRETE - EXEMPLO DE CONFIGURAÇÃO
# =============================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env && nano .env

# --- Ambiente ---
APP_NAME="Chama Frete"
APP_ENV=local
APP_DEBUG=true
BASE_URL="http://127.0.0.1:8000"
FRONTEND_URL="http://127.0.0.1:5173"

# --- Banco de Dados ---
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="chama_frete_dev"
DB_USER="root"
DB_PASS=""

# --- Segurança e Autenticação ---
# Gere em: openssl rand -hex 64
JWT_SECRET=""
JWT_EXPIRE=86400

# --- Mercado Pago ---
# Obtenha em: https://www.mercadopago.com.br/developers/panel/credentials
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# --- SMTP (E-mail) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Chama Frete Suporte"
SMTP_FROM_EMAIL=""

# --- Telegram (Notificações) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Sentry (Error Monitoring) ---
# Obtenha em: https://chamafrete.sentry.io/projects/ (criar projeto PHP)
SENTRY_DSN=""

# --- OpenWA (WhatsApp Gateway) ---
OPENWA_API_URL="http://localhost:2785"
OPENWA_API_KEY=""
OPENWA_SESSION_ID=""
